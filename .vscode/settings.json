{
  // Draws the guide lines that connect nested widgets in the editor gutter.
  // On a Flutter codebase this is the difference between reading a build method
  // and counting brackets.
  "dart.previewFlutterUiGuides": true,
  "dart.previewFlutterUiGuidesCustomTracking": true,

  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [80],
    "editor.selectionHighlight": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off"
  },

  // Keep generated and platform noise out of the file explorer and searches.
  "search.exclude": {
    "**/.dart_tool": true,
    "**/build": true,
    "**/ios/Pods": true
  },

  "dart.lineLength": 80,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true
}
