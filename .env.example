# PawPedia configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values. `.env` is gitignored;
# this example file is the only one that gets committed.
#
# The app loads these at startup with flutter_dotenv (see lib/core/app_config.dart).
# We deliberately do NOT use --dart-define-from-file, so there is exactly one
# place configuration comes from.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project Settings -> API. Use the *anon* (public) key.
# NEVER put the service_role key here: this file is read by the mobile app and
# anything in it ships inside the app bundle. The service_role key belongs only
# in the delete-account Edge Function's server-side environment.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- Breed API (PHP + MySQL REST API on Freehostia) ------------------------
# Base URL of the REST API, including /api. The app calls:
#   GET {BREED_API_BASE_URL}/breeds
#   GET {BREED_API_BASE_URL}/breeds/{id}
# Deploy server/ first (see README "Breed REST API"). Use https:// once SSL is
# enabled for the domain; until then the token travels unencrypted.
BREED_API_BASE_URL=
BREED_API_TOKEN=your-static-bearer-token
