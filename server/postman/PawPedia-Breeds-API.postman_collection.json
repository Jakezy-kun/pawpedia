{
  "info": {
    "name": "PawPedia Breeds API",
    "description": "Read-only REST API for the PawPedia breed catalogue.\n\nSelect the \"PawPedia - Local\" or \"PawPedia - Freehostia\" environment, set its `token`, then run the collection. Every request authenticates with `Authorization: Bearer {{token}}` inherited from the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Checks every response in the collection follows the API's REST contract.",
          "pm.test('Content-Type is application/json', () => {",
          "    if (pm.response.code === 204 || pm.response.code === 304) return;",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "pm.test('Body is pure JSON (nothing before it)', () => {",
          "    if (pm.response.code === 204 || pm.response.code === 304 || pm.request.method === 'HEAD') return;",
          "    const text = pm.response.text();",
          "    pm.expect(text.charAt(0), 'first character').to.be.oneOf(['{', '[']);",
          "    pm.response.json();",
          "});",
          "pm.test('Server does not reveal its PHP version', () => {",
          "    pm.expect(pm.response.headers.has('X-Powered-By')).to.be.false;",
          "});",
          "if (pm.response.code >= 400) {",
          "    pm.test('Errors use { error: { status, code, message } }', () => {",
          "        const error = pm.response.json().error;",
          "        pm.expect(error.status).to.eql(pm.response.code);",
          "        pm.expect(error.code).to.be.a('string');",
          "        pm.expect(error.message).to.be.a('string');",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Breeds",
      "item": [
        {
          "name": "List breeds",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/breeds", "host": ["{{base_url}}"], "path": ["breeds"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('has data, meta and links', () => {",
            "    pm.expect(body.data).to.be.an('array');",
            "    pm.expect(body.meta).to.include.keys('total', 'count', 'page', 'per_page', 'total_pages');",
            "    pm.expect(body.links).to.include.keys('self', 'first', 'last', 'prev', 'next');",
            "});",
            "pm.test('each breed has the documented fields', () => {",
            "    body.data.forEach(b => {",
            "        pm.expect(b.id).to.be.a('number');",
            "        pm.expect(b).to.include.keys('breed_name', 'breed_group', 'origin_country', 'average_lifespan', 'temperament', 'picture');",
            "    });",
            "});",
            "if (body.data.length) pm.collectionVariables.set('breed_id', body.data[0].id);",
            "pm.collectionVariables.set('etag', pm.response.headers.get('ETag') || '');"
          ] } }]
        },
        {
          "name": "List breeds - paginated",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/breeds?page=1&per_page=2",
              "host": ["{{base_url}}"], "path": ["breeds"],
              "query": [{ "key": "page", "value": "1" }, { "key": "per_page", "value": "2" }]
            }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('returns at most per_page rows', () => pm.expect(body.data.length).to.be.at.most(2));",
            "pm.test('prev is null on page 1', () => pm.expect(body.links.prev).to.be.null);"
          ] } }]
        },
        {
          "name": "Search by name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/breeds?search=golden",
              "host": ["{{base_url}}"], "path": ["breeds"],
              "query": [{ "key": "search", "value": "golden" }]
            }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('every result matches the search', () => {",
            "    pm.response.json().data.forEach(b => pm.expect(b.breed_name.toLowerCase()).to.include('golden'));",
            "});"
          ] } }]
        },
        {
          "name": "Filter by group (comma list)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/breeds?group=Sporting,Toy",
              "host": ["{{base_url}}"], "path": ["breeds"],
              "query": [{ "key": "group", "value": "Sporting,Toy" }]
            }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('every result is Sporting or Toy', () => {",
            "    pm.response.json().data.forEach(b => pm.expect(['sporting', 'toy']).to.include(b.breed_group.toLowerCase()));",
            "});"
          ] } }]
        },
        {
          "name": "Filter by country",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/breeds?country=Scotland",
              "host": ["{{base_url}}"], "path": ["breeds"],
              "query": [{ "key": "country", "value": "Scotland" }]
            }
          }
        },
        {
          "name": "Get one breed",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/breeds/{{breed_id}}", "host": ["{{base_url}}"], "path": ["breeds", "{{breed_id}}"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('returns the requested id', () => pm.expect(String(pm.response.json().data.id)).to.eql(String(pm.collectionVariables.get('breed_id'))));"
          ] } }]
        },
        {
          "name": "Conditional GET (ETag -> 304)",
          "request": {
            "method": "GET",
            "header": [{ "key": "If-None-Match", "value": "{{etag}}" }],
            "url": { "raw": "{{base_url}}/breeds", "host": ["{{base_url}}"], "path": ["breeds"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('unchanged catalogue is 304 Not Modified', () => pm.response.to.have.status(304));"
          ] } }]
        }
      ]
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "Missing token -> 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/breeds", "host": ["{{base_url}}"], "path": ["breeds"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
            "pm.test('WWW-Authenticate challenge', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer'));"
          ] } }]
        },
        {
          "name": "Unknown breed -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/breeds/999999", "host": ["{{base_url}}"], "path": ["breeds", "999999"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('404 breed_not_found', () => {",
            "    pm.response.to.have.status(404);",
            "    pm.expect(pm.response.json().error.code).to.eql('breed_not_found');",
            "});"
          ] } }]
        },
        {
          "name": "Invalid id -> 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/breeds/abc", "host": ["{{base_url}}"], "path": ["breeds", "abc"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 invalid_parameter', () => pm.response.to.have.status(400));"
          ] } }]
        },
        {
          "name": "Write attempt -> 405",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/breeds/{{breed_id}}", "host": ["{{base_url}}"], "path": ["breeds", "{{breed_id}}"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('405 with Allow header', () => {",
            "    pm.response.to.have.status(405);",
            "    pm.expect(pm.response.headers.get('Allow')).to.eql('GET, HEAD, OPTIONS');",
            "});"
          ] } }]
        }
      ]
    }
  ],
  "variable": [
    { "key": "breed_id", "value": "1" },
    { "key": "etag", "value": "" }
  ]
}
